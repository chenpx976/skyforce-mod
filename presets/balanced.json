    "luckFromEmptyRuns": 0.05,
    "maxLuckFromEmptyRuns": 0.85,
    "maxRunsWithoutDrop": 4
  },
  "skin": {
    "dropMultiplier": 3.5,
    "luckBias": 0.7,
    "luckFromBadLuck": 0.2,
    "maxLuckFromBadLuck": 0.8,
    "luckFromEmptyRuns": 0.05,
    "maxLuckFromEmptyRuns": 0.85,
    "maxRunsWithoutDrop": 5
  },
  "stars": {
    "multiplier": 1.5
  },
  "revive": {
    "enabled": true,
    "perStage": 2
  }
}
